# Copy to ~/.config/twenty-devdata/r2.env and chmod 600 that file.
# Use a personal Object Read token scoped only to the scrubbed-mirror bucket.
# Obtain bucket/endpoint and your own credential through the private ops workflow.
TWENTY_DEVDATA_BUCKET=replace-with-private-mirror-bucket
RCLONE_CONFIG_DEVDATA_TYPE=s3
RCLONE_CONFIG_DEVDATA_PROVIDER=Cloudflare
RCLONE_CONFIG_DEVDATA_REGION=auto
RCLONE_CONFIG_DEVDATA_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
RCLONE_CONFIG_DEVDATA_ACCESS_KEY_ID=replace-with-your-access-key-id
RCLONE_CONFIG_DEVDATA_SECRET_ACCESS_KEY=replace-with-your-secret-access-key
