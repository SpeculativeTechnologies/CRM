REACT_APP_SERVER_BASE_URL=http://localhost:3000
VITE_BUILD_SOURCEMAP=false


# ———————— Optional ————————
# REACT_APP_PORT=3001
# Shows a banner naming the environment. Deployed images set ENVIRONMENT_LABEL
# on the server instead.
# REACT_APP_ENVIRONMENT_LABEL=local
# VITE_ENABLE_SSL=false
# VITE_HOST=localhost.com
# SSL_KEY_PATH="./certs/your-cert.key"
# SSL_CERT_PATH="./certs/your-cert.crt"
# IS_DEBUG_MODE=false
# Local-first spike (see modules/local-first): set to the workspace's Postgres
# schema name (core.workspace.databaseSchema) to enable the debug panel.
# REACT_APP_LOCAL_FIRST_WORKSPACE_SCHEMA=workspace_xxxxxxxxxxxx
# REACT_APP_LOCAL_FIRST_ELECTRIC_URL=http://127.0.0.1:3010/v1/shape