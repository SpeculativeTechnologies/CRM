REACT_APP_SERVER_BASE_URL=http://localhost:3000
VITE_BUILD_SOURCEMAP=false


# ———————— Optional ————————
# REACT_APP_PORT=3001
# Shows a banner naming the environment. Deployed images set ENVIRONMENT_LABEL
# on the server instead.
# REACT_APP_ENVIRONMENT_LABEL=local
# VITE_ENABLE_SSL=false
# VITE_HOST=localhost.com
# SSL_KEY_PATH="./certs/your-cert.key"
# SSL_CERT_PATH="./certs/your-cert.crt"
# IS_DEBUG_MODE=false
# Local-first spike (see modules/local-first): enables the debug panel and
# sync loop. The server needs ELECTRIC_URL set for sync to actually flow.
# REACT_APP_IS_LOCAL_FIRST_ENABLED=true
# Second gate: with sync on but this off, local reads are computed and
# compared against the server without being served.
# REACT_APP_IS_LOCAL_FIRST_READS_ENABLED=true